{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letterbee",
  "main": "vinext/server/fetch-handler",
  "account_id": "6d03d35ec17b9be9e4febd16c6799b50",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 0.1 }, "redact_query_string": true },
  // Preserve only LetterBee's existing exact mounts; never route the website apex.
  "routes": [
    { "pattern": "beastry.app/letterbee", "zone_id": "abd87577fde0182b6c9ca431725a2865" },
    { "pattern": "beastry.app/letterbee/*", "zone_id": "abd87577fde0182b6c9ca431725a2865" },
    { "pattern": "www.beastry.app/letterbee", "zone_id": "abd87577fde0182b6c9ca431725a2865" },
    { "pattern": "www.beastry.app/letterbee/*", "zone_id": "abd87577fde0182b6c9ca431725a2865" }
  ],
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"] },
  "vars": { "MAIL_STORAGE_DRIVER": "kv", "NEXT_PUBLIC_BASE_PATH": "/letterbee" },
  // Dedicated namespace created through the authorized Cloudflare connector.
  "kv_namespaces": [{ "binding": "MAIL_STORE", "id": "d122d1cfd8b7430a8b4d18220d142185" }],
  // Dedicated private bucket; no managed public domain or custom domain enabled.
  "r2_buckets": [{ "binding": "LETTER_MEDIA", "bucket_name": "letterbee-media" }]
}
