{
  "name": "zhiduan-qingchang",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "dev:cloudflare": "NEXT_PUBLIC_BASE_PATH=/letterbee MAIL_STORAGE_DRIVER=kv vite dev --port 3001",
    "build:cloudflare": "NEXT_PUBLIC_BASE_PATH=/letterbee MAIL_STORAGE_DRIVER=kv vite build && next typegen",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime false"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.8.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vinext": "^1.4.6",
    "vite": "^8.3.8",
    "vitest": "^4.1.6",
    "wrangler": "^4.163.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "minimatch@>=7 <11.0.1": "11.0.1"
    }
  }
}
